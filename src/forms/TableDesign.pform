object TableDesignForm: TTableDesignForm
  Title = 'A new table'
  Width = 760
  Height = 560
  OnCreate = FormCreate
  object NameRow: TRow
    Gap = 8
    object NameLabel: TLabel
      Text = 'Table'
      Width = 70
    end
    object TableEdit: TEdit
      Grow = 1
      Placeholder = 'customers'
      OnChange = AnyChange
    end
  end
  object Parts: TRow
    Grow = 1
    Gap = 12
    Align = Stretch
    object ColumnsSide: TColumn
      Width = 360
      Gap = 6
      object ColumnsGrid: TGrid
        Grow = 1
        OnChange = ColumnSelect
      end
      object ColumnButtons: TRow
        Gap = 6
        object AddColumnButton: TButton
          Text = 'Add'
          Icon = 'add'
          Style = Secondary
          OnClick = AddColumnClick
        end
        object RemoveColumnButton: TButton
          Text = 'Remove'
          Style = Secondary
          OnClick = RemoveColumnClick
        end
        object UpButton: TButton
          Text = 'Up'
          Icon = 'up'
          Style = Secondary
          OnClick = UpClick
        end
      end
    end
    object ColumnFields: TColumn
      Grow = 1
      Gap = 8
      object ColumnNameEdit: TEdit
        Placeholder = 'The column''s name'
        OnChange = FieldChange
      end
      object TypeEdit: TEdit
        Placeholder = 'Its type: integer, text, varchar(80), numeric(10,2), date...'
        OnChange = FieldChange
      end
      object DefaultEdit: TEdit
        Placeholder = 'Default (SQL: 0, ''new'', current_timestamp)'
        OnChange = FieldChange
      end
      object KeyCheck: TCheckBox
        Text = 'Primary key'
        OnChange = FieldChange
      end
      object AutoCheck: TCheckBox
        Text = 'Numbered by the database (1, 2, 3...)'
        OnChange = FieldChange
      end
      object RequiredCheck: TCheckBox
        Text = 'Required (not null)'
        OnChange = FieldChange
      end
      object SqlLabel: TLabel
        Text = 'SQL'
        Bold = True
      end
      object SqlView: TMemo
        Grow = 1
        ReadOnly = True
        WordWrap = False
      end
    end
  end
  object Buttons: TRow
    Gap = 8
    object ErrorLabel: TLabel
      Grow = 1
      Text = ''
      Color = '#D32F2F'
    end
    object CancelButton: TButton
      Text = 'Cancel'
      Style = Secondary
      Cancel = True
      ModalResult = mrCancel
    end
    object CreateButton: TButton
      Text = 'Create the table'
      Default = True
      OnClick = CreateClick
    end
  end
end
